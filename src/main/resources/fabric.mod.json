{
	"schemaVersion": 1,
	"id": "adaptive-smelting",
	"version": "1.0.0",
	"name": "Adaptive smelting",
	"description": "A simple mod that adds bulk smelting depending on the current fuel type",
	"authors": [
		"Frein"
	],
	"contact": {
		"homepage": "https://github.com/freinIsCool/adaptive-smelting",
		"sources": "https://github.com/freinIsCool/adaptive-smelting"
	},
	"license": "CC0-1.0",
	"icon": "assets/adaptive-smelting/Icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.frein.adpfurnc.AdaptiveSmelting"
		],
		"client": [
			"com.frein.adpfurnc.client.AdaptiveSmeltingClient"
		],
		"fabric-datagen": [
			"com.frein.adpfurnc.client.AdaptiveSmeltingDataGenerator"
		]
	},
	"mixins": [
		"adaptive-smelting.mixins.json",
		{
			"config": "adaptive-smelting.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}